---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Dein Guide | BLEIB PAPA";
const description = "Die 21 Wege als PDF zum Herunterladen.";
const pdf = "/downloads/21-wege-bleib-papa.pdf";

/**
 * Die Fragen und die Ueberschrift darunter standen urspruenglich auf der
 * Verkaufsseite. Dort sind sie beim Umbau geflogen, weil sie den Leadmagneten
 * voraussetzen und einen fremden Besucher verwirren. Hier hat ihn gerade jeder
 * Leser heruntergeladen, deshalb gehoeren sie genau hierher.
 */
const fragen = [
  "Welcher Vater möchte ich jetzt sein?",
  "Was kann ich wirklich beeinflussen?",
  "Was braucht mein Kind von mir?",
  "Wie bleiben wir zwischen unseren gemeinsamen Tagen verbunden?",
  "Wie entsteht bei mir echter Papa-Alltag?",
  "Wie gehe ich mit dem Vermissen um?",
  "Was soll langfristig zwischen uns bleiben?",
];

const umfang = [
  "66 Audio-Dateien à ca. 10 Minuten, zusammen rund 11 Stunden",
  "Praxis-Workbook mit 157 Seiten im A4-Format",
  "Sechs Phasen, 30- und 90-Tage-Check-in",
  "Sofortiger digitaler Zugang",
];
---

<Base title={title} description={description} path="/guide/" noindex>
  <Header variant="landing" ctaHref="/blog/" />

  <main>
    <section class="section bg-creme">
      <div class="wrap">
        <div class="split guide-kopf" style="margin-top:0">
          <div>
            <p class="label">Dein Guide</p>
            <h1 class="h1">Da ist er.</h1>
            <div class="prose" style="margin-top:clamp(20px,2.4vw,28px)">
              <p>
                Danke fürs Bestätigen. Hier sind die 21 Wege, mit denen du eure Verbindung auch
                zwischen euren gemeinsamen Tagen stärken kannst.
              </p>
            </div>

            <p class="guide-aktion">
              <a class="btn" href={pdf} download>21 Wege als PDF herunterladen</a>
            </p>
            {/* Mail 1 der Strecke laeuft ueber Brevos Marketing-Pool und wird von GMX
                und web.de bei neuen Absendern haeufig einsortiert. Deshalb steht das
                hier als Kasten und nicht als Hilfstext: Ein Leser, der die Mail nie
                sieht, ist dauerhaft weg, waehrend einer, der den Stopper darunter
                uebergeht, das Programm in Mail 5 noch einmal angeboten bekommt.
                Gestaltung bewusst wie der Kasten in brevo/doi-mail.html, damit der
                Leser sie wiedererkennt, wenn die Mail kurz darauf ankommt. */}
            <p class="guide-hinweis">
              <strong>Kurz noch:</strong> Den Link bekommst du gleich auch per Mail. Falls sie
              nicht im Posteingang liegt, schau bitte im <strong>Spam-Ordner</strong> nach und
              zieh sie rüber. Dann landen auch die nächsten dort, wo sie hingehören.
            </p>
          </div>

          <figure class="fig">
            <img
              src="/assets/guide-mockup-devices.jpg"
              width="1000"
              height="1000"
              alt="Der Guide „21 Wege, deinem Kind nach der Trennung nah zu bleiben“ auf Tablet und Smartphone."
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ STOPPER ============ -->
    {/* Nach "14 Tage ausprobieren" denkt der Leser, er sei fertig. Hier bricht
        die Farbe, damit er haengen bleibt. Laut ist die Gestaltung, nicht der
        Text: Grossbuchstaben und Ausrufezeichen wuerden sofort nach Verkauf
        klingen und genau das Vertrauen kosten, das die Marke ausmacht. */}
    <section class="stopper bg-navy">
      <div class="wrap">
        <p class="stopper-dach">Moment noch</p>
        <h2 class="stopper-titel">Möchtest du mehr als ein paar Ideen?</h2>
        <p class="stopper-text">
          Die 21 Wege sind ein guter Anfang. Sie geben dir Impulse, die du morgen ausprobieren
          kannst, aber keinen Weg für die Monate danach. Darum geht es hier unten.
        </p>
        <span class="stopper-pfeil" aria-hidden="true">↓</span>
      </div>
    </section>

    <!-- ============ BRÜCKE ZUM PROGRAMM ============ -->
    <section class="section bg-creme">
      <div class="wrap">
        <p class="label">Der nächste Schritt</p>
        <h2 class="h2 measure-wide">
          21 Wege geben dir Ideen. Das <span class="marke">66-Tage-Programm</span> gibt dir einen
          Weg.
        </h2>

        <div class="bruecke">
          <div class="bruecke-text">
            <p>
              Mit den 21 Wegen kannst du einzelne Dinge sofort ausprobieren: kleine Rituale,
              Kontaktpunkte und Momente von Verbindung. Das ist ein guter Anfang.
            </p>
            <p>
              Aber eine neue Form von Vatersein entsteht nicht aus einer immer längeren Liste guter
              Ideen. Sie entsteht aus Fragen wie:
            </p>

            <ul class="fragen">
              {fragen.map((f) => <li>{f}</li>)}
            </ul>

            <p class="bruecke-pointe">
              66 Tage bedeutet nicht: 66 weitere Tipps. 66 Tage bedeutet: jeden Tag einen kleinen
              Schritt weiter.
            </p>
          </div>

          <div class="bruecke-produkt">
            <figure class="bruecke-bild">
              <picture>
                <source
                  type="image/webp"
                  srcset="/assets/66-tage-mockup-400.webp 400w, /assets/66-tage-mockup-600.webp 600w, /assets/66-tage-mockup-700.webp 700w, /assets/66-tage-mockup.webp 1000w"
                  sizes="(min-width: 900px) 400px, calc(100vw - 48px)"
                />
                <img
                  src="/assets/66-tage-mockup.jpg"
                  width="1000"
                  height="1000"
                  alt="BLEIB PAPA, 66 Tage für eure Verbindung: Programmbox, Workbook und Kursoberfläche auf Bildschirm, Tablet und Smartphone."
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </figure>

            <ul class="umfang">
              {umfang.map((u) => <li>{u}</li>)}
            </ul>

            {/* Bewusst ohne Preis und ohne Kasse: Wer gerade etwas Kostenloses
                herunterlaedt, soll nicht im selben Moment eine Zahl sehen, der
                das Argument fehlt. Das steht alles auf der Verkaufsseite. */}
            <p class="bruecke-aktion">
              <a class="btn btn-full" href="/66-tage/">Das 66-Tage-Programm ansehen</a>
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Der Produktname hebt sich ab: Farbe plus ein weicher Strich, der unter
     der Grundlinie liegt. Als Verlauf im Hintergrund, nicht als Rahmen,
     damit er bei einem Zeilenumbruch auf beiden Zeilen mitlaeuft. */
  .marke {
    color: var(--rost);
    background-image: linear-gradient(
      transparent 72%,
      rgba(238, 130, 54, 0.3) 72%,
      rgba(238, 130, 54, 0.3) 94%,
      transparent 94%
    );
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  @media (min-width: 961px) {
    .guide-kopf {
      align-items: center;
    }
  }

  .guide-aktion {
    margin-top: clamp(24px, 2.8vw, 32px);
  }
  .guide-hinweis {
    margin-top: 18px;
    background: #fff;
    border-left: 3px solid var(--rost);
    padding: 15px 18px;
    font-size: 15.5px;
    line-height: 1.6;
  }
  .guide-hinweis strong {
    color: var(--navy);
  }

  /* Auf dem Telefon steht das Produktbild vor dem Download-Knopf, so wie im
     Hero der Verkaufsseite. display:contents loest den Textblock auf, dann
     lassen sich Bild und Knopf mit order sortieren. */
  /* 960 und nicht weniger: Bei genau dieser Breite wird .split in global.css
     einspaltig. Lag die Grenze darunter, war die Seite dazwischen schon
     gestapelt, die Umsortierung aber noch aus, und das Bild stand wieder
     hinter dem Knopf. */
  @media (max-width: 960px) {
    .guide-kopf {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .guide-kopf > div:first-child {
      display: contents;
    }
    .guide-kopf .fig {
      order: 1;
      margin-top: 18px;
    }
    .guide-kopf .fig img {
      max-width: 320px;
      margin-inline: auto;
    }
    .guide-kopf .guide-aktion {
      order: 2;
      margin-top: 20px;
    }
    .guide-kopf .guide-hinweis {
      order: 3;
    }
  }
  .bruecke {
    display: grid;
    gap: clamp(30px, 4vw, 56px);
    margin-top: clamp(22px, 2.6vw, 32px);
    align-items: start;
  }
  @media (min-width: 900px) {
    .bruecke {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    }
  }
  .bruecke-text p {
    max-width: 560px;
    margin: 0 0 16px;
    line-height: 1.7;
  }

  .fragen {
    list-style: none;
    margin: clamp(18px, 2vw, 24px) 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .fragen li {
    position: relative;
    padding-left: 20px;
    font-family: var(--serif);
    font-size: clamp(16px, 1.7vw, 17.5px);
    line-height: 1.45;
    color: var(--ink);
  }
  /* Ein Strich statt eines Punktes: Es sind Fragen, keine Aufzählung von
     Leistungen. */
  .fragen li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: var(--rost);
  }
  .bruecke-pointe {
    max-width: 560px;
    margin: clamp(20px, 2.4vw, 26px) 0 0 !important;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-family: var(--serif);
    font-size: clamp(17px, 1.9vw, 19px);
    line-height: 1.55;
    color: var(--ink);
  }

  .bruecke-produkt {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(23, 39, 61, 0.04),
      0 12px 30px rgba(23, 39, 61, 0.06);
    padding: clamp(22px, 2.6vw, 30px);
  }
  .bruecke-bild {
    margin: 0 0 20px;
  }
  .bruecke-bild img {
    width: 100%;
    max-width: 380px;
    margin-inline: auto;
    display: block;
  }
  .umfang {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .bruecke-aktion {
    margin: clamp(22px, 2.6vw, 28px) 0 0;
  }
  /* ---------- Stopper ---------- */
  .stopper {
    padding: clamp(40px, 5vw, 64px) 0 clamp(34px, 4vw, 52px);
    text-align: center;
  }
  .stopper-dach {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sand);
    margin: 0 0 14px;
  }
  .stopper-titel {
    font-family: var(--serif);
    font-size: clamp(27px, 4vw, 42px);
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--creme);
    margin: 0 auto 16px;
    max-width: 18ch;
  }
  .stopper-text {
    max-width: 52ch;
    margin: 0 auto;
    font-size: clamp(15.5px, 1.6vw, 17px);
    line-height: 1.65;
    color: rgba(251, 247, 241, 0.82);
  }
  /* Der Pfeil zeigt, wohin. Er wippt leicht, das zieht den Blick nach unten,
     ohne dass ein Wort schreien muss. */
  .stopper-pfeil {
    display: block;
    margin-top: clamp(22px, 2.6vw, 30px);
    font-size: 26px;
    line-height: 1;
    color: var(--orange);
    animation: wippen 1.9s ease-in-out infinite;
  }
  @keyframes wippen {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(7px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stopper-pfeil {
      animation: none;
    }
  }

  .umfang li {
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--body);
  }
</style>
