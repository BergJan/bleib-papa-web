<script>
  /**
   * Zwei Dinge: die Kaufleiste am unteren Rand und benannte Klick-Ereignisse.
   *
   * Die Ereignisse gehen an GA4 und an den Meta-Pixel, aber nur, wenn der
   * Besucher dem Tracking zugestimmt hat. Vorher gibt es weder gtag noch fbq,
   * deshalb die Prüfung bei jedem Aufruf statt einmal beim Laden.
   */
  type Fenster = Window & {
    gtag?: (...args: unknown[]) => void;
    fbq?: (...args: unknown[]) => void;
  };

  const melden = (name: string, daten: Record<string, unknown> = {}) => {
    const w = window as Fenster;
    w.gtag?.("event", name, daten);
    w.fbq?.("trackCustom", name, daten);
  };

  /* ---------- Klicks auf die Kauf-Buttons ---------- */
  for (const el of document.querySelectorAll<HTMLAnchorElement>("[data-kauf]")) {
    el.addEventListener("click", () => melden("kauf_klick", { platz: el.dataset.kauf }));
  }

  const sprung = document.querySelector<HTMLAnchorElement>("[data-audio-sprung]");
  sprung?.addEventListener("click", () => melden("hoerprobe_sprung"));

  /* ---------- Hörprobe: Start, Hälfte, Ende ---------- */
  const audio = document.querySelector<HTMLAudioElement>("[data-hoerprobe]");
  if (audio) {
    let halb = false;
    audio.addEventListener("play", () => melden("hoerprobe_start"), { once: true });
    audio.addEventListener("timeupdate", () => {
      if (halb || !audio.duration) return;
      if (audio.currentTime / audio.duration >= 0.5) {
        halb = true;
        melden("hoerprobe_halb");
      }
    });
    audio.addEventListener("ended", () => melden("hoerprobe_ende"), { once: true });
  }

  /**
   * Abschnitte blenden sich beim Scrollen auf.
   *
   * Die Klasse wird erst hier vergeben, nicht im Markup: Ohne JavaScript oder
   * ohne IntersectionObserver steht alles sofort sichtbar da, statt unsichtbar
   * zu bleiben. Wer Bewegung abbestellt hat, bekommt gar keine.
   */
  const ruhig = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!ruhig && "IntersectionObserver" in window) {
    const bloecke: HTMLElement[] = [];

    for (const bereich of document.querySelectorAll("main > section")) {
      /* Der Hero blendet nicht ein: Er ist das Erste, was ein Besucher sieht,
         und soll sofort stehen, nicht nach einer halben Sekunde. Das Laufband
         bewegt sich ohnehin und braucht keinen zweiten Auftritt. */
      if (bereich.classList.contains("hero")) continue;
      if (bereich.classList.contains("band-stimmen")) continue;

      const rahmen = bereich.querySelector(":scope > .wrap, :scope > .band-text");
      const kinder = rahmen ? [...rahmen.children] : [...bereich.children];

      kinder.forEach((kind, i) => {
        const el = kind as HTMLElement;
        el.classList.add("zeigt-sich");
        /* Höchstens drei Stufen, sonst wirkt es wie eine Diashow. */
        el.style.transitionDelay = `${Math.min(i, 2) * 90}ms`;
        bloecke.push(el);
      });
    }

    const beobachter = new IntersectionObserver(
      (eintraege) => {
        for (const e of eintraege) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("ist-da");
          beobachter.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0 },
    );

    for (const b of bloecke) beobachter.observe(b);
  }

  /**
   * Der Punkt auf dem Zeitstrahl läuft beim Scrollen mit.
   *
   * Maßstab ist die Mitte des Fensters: Was darüber liegt, gilt als gelesen.
   * Der Punkt wandert von der ersten bis zur letzten Phase, die Linie dahinter
   * färbt sich mit, und jede passierte Phase behält ihre Markierung.
   */
  const strahl = document.getElementById("zeitstrahl");

  if (strahl && !ruhig) {
    const phasen = [...strahl.querySelectorAll<HTMLElement>(".phase")];
    let wartet = false;

    const nachfuehren = () => {
      wartet = false;
      const rahmen = strahl.getBoundingClientRect();
      const mitte = window.innerHeight / 2;

      /* 10 Pixel Versatz: Dort beginnt und endet die gezeichnete Linie. */
      const weg = Math.min(Math.max(mitte - rahmen.top - 10, 0), rahmen.height - 20);
      strahl.style.setProperty("--fortschritt", `${weg}px`);
      strahl.classList.toggle("laeuft", rahmen.top < mitte && rahmen.bottom > mitte);

      for (const p of phasen) {
        const punkt = p.getBoundingClientRect().top + 24 - rahmen.top;
        p.classList.toggle("ist-erreicht", weg >= punkt - 10);
      }
    };

    addEventListener(
      "scroll",
      () => {
        if (wartet) return;
        wartet = true;
        requestAnimationFrame(nachfuehren);
      },
      { passive: true },
    );
    addEventListener("resize", nachfuehren, { passive: true });
    nachfuehren();
  }

  /**
   * Stimmen in Abschnitt 8 auf dem Telefon aufklappen.
   *
   * Erst hier bekommt die Liste die Klasse, die das Kuerzen erlaubt, und erst
   * hier erscheint der Knopf. Ohne JavaScript stehen damit alle Stimmen da,
   * statt hinter einem Knopf zu verschwinden, der nichts tut.
   */
  const wand = document.querySelector(".stimmen");
  const mehr = document.querySelector<HTMLButtonElement>("[data-stimmen-mehr]");

  if (wand && mehr) {
    wand.classList.add("kann-klappen");
    mehr.hidden = false;
    const beschriftung = mehr.textContent?.trim() ?? "";

    mehr.addEventListener("click", () => {
      const offen = wand.classList.toggle("ist-offen");
      mehr.setAttribute("aria-expanded", String(offen));
      mehr.textContent = offen ? "Weniger anzeigen" : beschriftung;

      /* Beim Zuklappen zurueck zum Anfang des Abschnitts, sonst steht der
         Leser ploetzlich im naechsten Kapitel. */
      if (!offen) {
        wand.closest("section")?.scrollIntoView({ block: "start", behavior: "smooth" });
      }
    });
  }

  /* ---------- Laufband anhalten ---------- */
  /* Ohne sichtbaren Knopf, aber nicht ohne Halt: Am Rechner stoppt das Band,
     sobald die Maus darüber liegt oder die Tastatur hineinspringt. Auf dem
     Telefon gibt es beides nicht, dort hält ein Tippen auf das Band an und
     das nächste lässt es weiterlaufen. */
  const band = document.getElementById("stimmenband");

  band?.addEventListener("click", () => {
    band.classList.toggle("ist-angehalten");
  });

  /* ---------- Kaufleiste am unteren Rand ---------- */
  const leiste = document.getElementById("sticky-kauf");
  const heroButton = document.querySelector('.hero [data-kauf="hero"]');
  const angebot = document.getElementById("starten");

  if (leiste && heroButton && angebot) {
    /* Die Leiste erscheint, sobald der Hero-Button aus dem Bild ist, und
       verschwindet wieder, sobald der Kaufblock selbst zu sehen ist: Dort
       steht derselbe Button schon in voller Größe. */
    let heroWeg = false;
    let angebotDa = false;

    const pruefen = () => {
      leiste.hidden = !(heroWeg && !angebotDa);
    };

    new IntersectionObserver(
      ([e]) => {
        heroWeg = !e.isIntersecting;
        pruefen();
      },
      { threshold: 0 },
    ).observe(heroButton);

    new IntersectionObserver(
      ([e]) => {
        angebotDa = e.isIntersecting;
        pruefen();
      },
      { threshold: 0 },
    ).observe(angebot);
  }
</script>

<style>
  /* ---------- Auftritt beim Scrollen ---------- */
  /* Zurückhaltend: vierzehn Pixel Weg, eine halbe Sekunde, einmalig. Mehr
     wirkt schnell nach Effekt statt nach Wertigkeit. */
  .zeigt-sich {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .zeigt-sich.ist-da {
    opacity: 1;
    transform: none;
  }

  /* ---------- 1 · Hero ---------- */
  /* Auf dem Telefon müssen Überschrift, Text und beide Buttons ohne Scrollen
     sichtbar sein. Deshalb hier engere Abstände als im Standard-Hero. */
  .hero-col .label {
    margin-bottom: 14px;
  }
  .hero-col .h1 {
    margin-bottom: 16px;
  }
  .hero-col .lead {
    margin-bottom: 0;
  }

  /* Warmer Lichtschein hinter dem Mockup. Gibt dem Hero Tiefe, ohne ein
     weiteres Element einzuführen. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -14%;
    right: -8%;
    width: min(760px, 68vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(238, 130, 54, 0.16) 0%,
      rgba(238, 130, 54, 0.06) 42%,
      transparent 68%
    );
    pointer-events: none;
  }

  .kopf-kauf {
    display: none;
  }
  @media (min-width: 900px) {
    .kopf-kauf {
      display: inline-flex;
      color: #fff;
    }
    .kopf-kauf:hover {
      color: #fff;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 26px;
      padding-bottom: 30px;
    }
    .hero-col .h1 {
      font-size: clamp(27px, 7.6vw, 34px);
      line-height: 1.14;
      margin-bottom: 13px;
    }
    .hero-col .lead {
      font-size: 15.5px;
      line-height: 1.55;
    }
    /* Auf dem Telefon steht das Produktbild vor dem Button.
       display:contents loest den Textblock auf, dadurch werden Dachzeile,
       Ueberschrift, Fliesstext, Bild und Button zu Geschwistern in einer
       Reihe, und der Button laesst sich mit order ans Ende schieben. */
    .hero-grid {
      display: flex;
      flex-direction: column;
      /* Als Raster galt der gap aus global.css nur zwischen Text und Bild.
         Als Flex-Spalte wirkt er zwischen allen fuenf Elementen und addiert
         sich zu deren Eigenabstaenden. Deshalb hier aus, die Abstaende
         kommen von den Elementen selbst. */
      gap: 0;
    }
    .hero-col {
      display: contents;
    }
    .hero-visual {
      margin-top: 13px;
    }
    /* 3, weil .hero-visual in global.css schon order: 2 traegt. */
    .hero-grid :global(.kauf-cta) {
      order: 3;
      margin-top: 18px;
    }
  }

  /* ---------- 2 · Schmerz ---------- */
  .szenen {
    max-width: 640px;
    display: grid;
    gap: 18px;
    margin: clamp(22px, 2.6vw, 30px) 0 0;
  }
  .szenen p {
    margin: 0;
    padding-left: 18px;
    border-left: 2px solid var(--line);
    font-family: var(--serif);
    font-size: clamp(17px, 1.8vw, 19px);
    line-height: 1.6;
    color: var(--ink);
  }
  .szenen-schluss {
    max-width: 640px;
    margin: clamp(22px, 2.6vw, 28px) 0 0;
    font-weight: 700;
    color: var(--ink);
  }
  .fig-schmal {
    max-width: 640px;
    margin: clamp(28px, 3.4vw, 40px) 0 0;
  }

  /* ---------- 3 · Reframe ---------- */
  .band-reframe {
    position: relative;
    isolation: isolate;
    padding: clamp(60px, 8vw, 110px) 0;
    background: var(--navy);
    overflow: hidden;
  }
  .band-bild {
    position: absolute;
    inset: 0;
    z-index: -1;
    margin: 0;
    display: block;
  }
  .band-bild img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Der Text steht darüber, deshalb das Bild deutlich zurücknehmen. */
    opacity: 0.3;
  }
  /* Zusätzlicher Verlauf von links: Das Foto hat helle Stellen, und der Text
     muss auch darüber lesbar bleiben, nicht nur über den dunklen. */
  .band-reframe::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(16, 35, 63, 0.82) 0%,
      rgba(16, 35, 63, 0.62) 46%,
      rgba(16, 35, 63, 0.3) 100%
    );
  }
  .band-text {
    max-width: 820px;
  }
  .band-gross {
    font-family: var(--serif);
    font-size: clamp(28px, 4.4vw, 46px);
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--creme);
    margin: 0 0 18px;
  }
  .band-klein {
    font-size: clamp(16px, 1.7vw, 18px);
    line-height: 1.65;
    color: rgba(251, 247, 241, 0.84);
    margin: 0;
    max-width: 640px;
  }

  /* ---------- 4 · Vorher / Nachher ---------- */
  .wandel {
    margin-top: clamp(22px, 2.6vw, 32px);
  }
  .wandel-kopf,
  .wandel-paar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(14px, 2vw, 28px);
  }
  .wandel-titel {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .wandel-titel.ist-heute {
    color: var(--meta);
  }
  .wandel-titel.ist-danach {
    color: var(--rost);
  }
  .wandel-paar {
    border-top: 1px solid var(--line);
  }
  .wandel-zelle {
    position: relative;
    margin: 0;
    padding: 16px 0 16px 16px;
    font-size: 15.5px;
    line-height: 1.55;
  }
  .wandel-zelle.ist-heute {
    color: var(--meta-text);
  }
  .wandel-zelle.ist-danach {
    color: var(--ink);
    font-weight: 600;
  }
  .wandel-marke {
    position: absolute;
    left: 0;
    top: 19px;
    width: 3px;
    height: 16px;
    border-radius: 2px;
  }
  .ist-heute .wandel-marke {
    background: var(--meta);
  }
  .ist-danach .wandel-marke {
    background: var(--rost);
  }
  .nur-mobil {
    display: none;
  }

  @media (max-width: 760px) {
    /* Kartenpaare untereinander: Zwei Spalten nebeneinander wären auf dem
       Telefon zwei Wortsäulen. */
    .wandel-kopf {
      display: none;
    }
    .wandel-paar {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 18px;
      border-top: 0;
    }
    .wandel-zelle {
      padding: 14px 16px;
      border-radius: 2px;
    }
    .wandel-zelle.ist-heute {
      background: #f1ece4;
    }
    .wandel-zelle.ist-danach {
      background: var(--white);
      border: 1px solid var(--line);
      border-left: 3px solid var(--rost);
    }
    .wandel-marke {
      display: none;
    }
    .nur-mobil {
      display: block;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin-bottom: 6px;
      color: var(--meta);
    }
    .ist-danach .nur-mobil {
      color: var(--rost);
    }
  }

  /* ---------- 5 · Jans Geschichte ---------- */
  .geschichte {
    display: grid;
    gap: clamp(26px, 3.6vw, 52px);
  }
  @media (min-width: 900px) {
    /* Das Porträt nimmt gut 40 Prozent: Die Geschichte trägt den Abschnitt,
       und ein Gesicht dazu wirkt nur, wenn man es auch sieht. */
    .geschichte {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .portrait {
    margin: 0;
  }
  .portrait img {
    width: 100%;
    border-radius: 2px;
    display: block;
  }
  .geschichte-text p:not(.label):not(.signatur):not(.ps) {
    max-width: 640px;
    margin: 0 0 16px;
    line-height: 1.7;
  }
  .geschichte-text .h2 {
    margin-bottom: 20px;
  }
  .signatur {
    margin: 22px 0 0;
    font-family: var(--serif);
    font-size: 16px;
    color: var(--meta-text);
  }
  .ps {
    max-width: 580px;
    margin: clamp(20px, 2.4vw, 28px) 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--body);
  }
  .ps strong {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--rost);
    margin-right: 4px;
  }
  @media (max-width: 899px) {
    .portrait {
      max-width: 240px;
    }
    .portrait img {
      border-radius: 50%;
      aspect-ratio: 1;
      object-fit: cover;
    }
  }

  /* ---------- 6 · So funktioniert's ---------- */
  .schritte {
    list-style: none;
    margin: clamp(22px, 2.6vw, 32px) 0 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  @media (min-width: 860px) {
    .schritte {
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(18px, 2.4vw, 32px);
    }
  }
  .schritte li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  @media (min-width: 860px) {
    .schritte li {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-top: 16px;
      border-top: 2px solid var(--line);
    }
  }
  .schritt-nr {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--creme);
    color: var(--rost);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 700;
  }
  .schritte p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
  }
  .schritte strong {
    color: var(--ink);
  }
  .schritte-schluss {
    margin: clamp(24px, 2.8vw, 32px) 0 0;
    max-width: 640px;
    color: var(--body);
  }

  /* ---------- 7 · Phasen ---------- */
  /* Ein echter Zeitstrahl statt einer Liste: eine durchgehende Linie und je
     Phase ein Punkt darauf. Der Abschnitt heißt so, jetzt sieht er auch so aus. */
  .zeitstrahl {
    position: relative;
    margin-top: clamp(22px, 2.6vw, 32px);
    padding-left: 26px;
  }
  .zeitstrahl::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: linear-gradient(
      to bottom,
      var(--line) 0,
      var(--line) 88%,
      transparent 100%
    );
  }
  .phase {
    position: relative;
    border-bottom: 1px solid var(--line);
  }
  .phase::before {
    content: "";
    position: absolute;
    left: -26px;
    top: 24px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--creme);
    border: 1px solid var(--meta);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  /* Schon durchlaufene Phasen bleiben markiert. Der Weg, den man hinter sich
     hat, soll sichtbar sein, nicht nur der Punkt, an dem man steht. */
  .phase.ist-erreicht::before {
    background: var(--sand);
    border-color: var(--rost);
  }

  /* Die offene Phase markiert, wo der Leser gerade steht. Steht nach
     .ist-erreicht, damit sie bei gleicher Gewichtung gewinnt. */
  .phase[open]::before {
    background: var(--rost);
    border-color: var(--rost);
    box-shadow: 0 0 0 3px rgba(196, 85, 26, 0.14);
  }

  /* Der mitlaufende Punkt und die Linie, die er hinter sich zieht. Beides
     hängt an --fortschritt, das vom Skript gesetzt wird. */
  .zeitstrahl::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 10px;
    width: 1px;
    height: var(--fortschritt, 0px);
    background: var(--rost);
    opacity: 0.55;
  }
  .lauf-punkt {
    position: absolute;
    left: 1px;
    top: calc(10px + var(--fortschritt, 0px));
    width: 9px;
    height: 9px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--rost);
    box-shadow: 0 0 0 4px rgba(196, 85, 26, 0.16);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  /* Erst sichtbar, wenn der Strahl im Bild ist, sonst klebt er oben am Rand. */
  .zeitstrahl.laeuft .lauf-punkt {
    opacity: 1;
  }
  .phase summary {
    cursor: pointer;
    list-style: none;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto 16px;
    gap: 6px 14px;
    align-items: baseline;
    padding: 16px 0;
  }
  .phase summary::-webkit-details-marker {
    display: none;
  }
  /* Ohne Zeichen sieht niemand, dass sich die Zeile öffnen lässt. */
  .phase summary::after {
    content: "+";
    justify-self: end;
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1;
    color: var(--rost);
  }
  .phase[open] summary::after {
    content: "–";
  }
  .phase summary:hover .phase-titel {
    color: var(--rost);
  }
  .phase-titel {
    transition: color 0.16s ease;
  }
  .phase-nr {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rost);
  }
  .phase-tage {
    font-size: 12.5px;
    color: var(--meta-text);
  }
  .phase-titel {
    font-family: var(--serif);
    font-size: clamp(17px, 1.9vw, 20px);
    color: var(--ink);
  }
  .phase-wort {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--meta);
  }
  .phase-frage {
    margin: 0 0 20px;
    max-width: 640px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--body);
  }
  @media (max-width: 760px) {
    .phase summary {
      grid-template-columns: auto minmax(0, 1fr) 16px;
    }
    .phase-titel,
    .phase-wort {
      grid-column: 1 / 3;
    }
    .phase summary::after {
      grid-row: 1;
      grid-column: 3;
    }
  }
  .phasen-schluss {
    margin: clamp(24px, 2.8vw, 32px) 0 0;
    max-width: 640px;
    color: var(--body);
  }

  /* Stimmen und Angebot stehen beide auf warmem Grund, damit die weißen Karten
     darauf schweben. Drei warme Abschnitte hintereinander würden ineinander
     laufen, deshalb trennt sie eine Haarlinie statt eines Farbwechsels. */
  .naht-oben {
    border-top: 1px solid var(--line);
  }

  /* ---------- 1b · Stimmenband unter dem Hero ---------- */
  .band-stimmen {
    padding: clamp(18px, 2vw, 26px) 0 clamp(12px, 1.4vw, 16px);
  }
  /* Im Band deutlich kleiner als in der Wand: Es soll Vertrauen stiften und
     den Hero stützen, nicht mit ihm um Aufmerksamkeit ringen. Deshalb auch ein
     flacherer Schatten, die Karten sollen nicht schweben, sondern mitlaufen. */
  .stimme.ist-klein {
    padding: 12px 14px;
    box-shadow: 0 1px 2px rgba(23, 39, 61, 0.04);
  }
  .stimme.ist-klein p {
    margin-bottom: 10px;
    font-size: 12px;
    line-height: 1.45;
  }
  /* Monogramm und Name links, Sterne rechtsbündig. Die dritte Spalte bleibt
     leer, solange keine Bewertung hinterlegt ist. */
  .stimme.ist-klein footer {
    padding-top: 8px;
    grid-template-columns: 19px minmax(0, 1fr) auto;
    gap: 7px;
  }
  .sterne {
    display: inline-flex;
    gap: 2px;
    justify-self: end;
  }
  .stern {
    width: 12px;
    height: 12px;
    fill: var(--line);
  }
  .stern.ist-voll {
    fill: var(--orange);
  }
  .stimme.ist-klein .monogramm {
    width: 19px;
    height: 19px;
    font-size: 8px;
  }
  .stimme.ist-klein .stimme-name {
    font-size: 11px;
  }
  .stimme.ist-klein .stern {
    width: 9px;
    height: 9px;
  }

  /* ---------- Laufband ---------- */
  /* Über die volle Fensterbreite, die Ränder ausgeblendet, damit die Karten
     nicht abgeschnitten wirken, sondern aus dem Bild heraus- und
     hineinwandern. */
  .laufband {
    overflow: hidden;
    /* Schatten brauchen oben und unten Luft, sonst beschneidet sie der Rahmen. */
    padding-block: 8px;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
  }
  /* Abstand als Rand an der Karte, nicht als gap der Spur. Bei zehn Karten
     sind zehn Ränder enthalten, dadurch ist die halbe Spurbreite exakt eine
     Runde. Mit gap wären es nur neun Zwischenräume, und das Band würde bei
     jedem Durchlauf um einen halben Abstand springen. */
  .band-spur {
    display: flex;
    width: max-content;
    align-items: stretch;
  }
  /* Im Band feste Breite, in der Wand nicht: Dort sollen die Spalten die
     Breite bestimmen. */
  .band-spur .stimme {
    flex: 0 0 clamp(210px, 58vw, 256px);
    margin-right: clamp(18px, 2vw, 26px);
  }

  /* ---------- 8 · Stimmen als Wand ---------- */
  /* Handy eine Spalte, Tablet zwei, Rechner drei. Spalten statt Raster, damit
     unterschiedlich lange Karten gleichmäßig füllen und am Ende keine
     angebrochene Zeile steht. */
  .stimmen {
    margin-top: clamp(22px, 2.6vw, 32px);
    columns: 1;
    column-gap: clamp(16px, 1.8vw, 22px);
  }
  @media (min-width: 680px) {
    .stimmen {
      columns: 2;
    }
  }
  @media (min-width: 1020px) {
    .stimmen {
      columns: 3;
    }
  }
  .stimmen .stimme {
    break-inside: avoid;
    margin-bottom: clamp(16px, 1.8vw, 22px);
  }
  .band-spur.nach-links {
    animation: lauf-links 72s linear infinite;
  }
  .band-spur.nach-rechts {
    animation: lauf-rechts 72s linear infinite;
  }
  /* Die Spur enthält ihre Karten zweimal, deshalb sind 50 Prozent genau eine
     volle Runde und der Übergang ist unsichtbar. */
  @keyframes lauf-links {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes lauf-rechts {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  /* Anhalten beim Lesen: Maus darüber, Tastaturfokus darin, oder per Knopf. */
  .laufband:hover .band-spur,
  .laufband:focus-within .band-spur,
  .laufband.ist-angehalten .band-spur {
    animation-play-state: paused;
  }

  .stimmen-fuss {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 20px;
    margin-top: clamp(14px, 1.8vw, 20px);
  }

  /* Weiße Karte mit Haarlinie und weichem Schatten statt flacher Fläche mit
     Akzentstrich. Die Tiefe macht den Unterschied zwischen Zeitungsspalte und
     Produkt. Dieselbe Sprache nutzt auch der Angebotsblock. */
  .stimme {
    position: relative;
    margin: 0;
    padding: clamp(24px, 2.6vw, 32px);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow:
      0 1px 2px rgba(23, 39, 61, 0.04),
      0 10px 28px rgba(23, 39, 61, 0.055);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .stimme p {
    margin: 0 0 22px;
    font-family: var(--serif);
    font-size: clamp(16.5px, 1.7vw, 17.5px);
    line-height: 1.7;
    color: var(--ink);
  }
  .stimme p::before {
    content: "„";
  }
  .stimme p::after {
    content: "“";
  }

  .stimme footer {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  /* Monogramm statt Stockfoto: Es gibt der Stimme ein Gesicht, ohne jemanden
     zu zeigen, den es so nicht gibt. */
  .monogramm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--creme);
    border: 1px solid var(--line);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--rost);
  }
  .stimme-name {
    display: block;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--ink);
  }
  .stimme-lage {
    display: block;
    font-size: 12.5px;
    color: var(--meta-text);
  }

  @media (hover: hover) {
    .stimme:hover {
      transform: translateY(-2px);
      box-shadow:
        0 1px 2px rgba(23, 39, 61, 0.05),
        0 16px 38px rgba(23, 39, 61, 0.09);
    }
  }

  /* Wer Bewegung abbestellt hat, bekommt keine. Dann stehen die Karten still
     und lassen sich von Hand schieben, statt von selbst zu laufen. */
  @media (prefers-reduced-motion: reduce) {
    .stimme:hover {
      transform: none;
    }
    .band-spur {
      animation: none !important;
      transform: none !important;
    }
    .laufband {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .stimme {
      scroll-snap-align: center;
    }
  }

  /* Nur auf dem Telefon, und nur wenn das Skript gelaufen ist: drei Karten
     als Vorschau, der Rest hinter dem Knopf. Ab 680 Pixeln stehen die Karten
     in Spalten, dort ist die Liste ohnehin kurz genug. */
  @media (max-width: 679px) {
    .stimmen.kann-klappen:not(.ist-offen) .stimme:nth-child(n + 4) {
      display: none;
    }
    /* Die dritte Karte laeuft nach unten aus, damit sichtbar ist, dass da
       noch mehr kommt. */
    .stimmen.kann-klappen:not(.ist-offen) .stimme:nth-child(3) {
      -webkit-mask-image: linear-gradient(180deg, #000 48%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 48%, transparent 100%);
    }
  }
  .stimmen-mehr {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    width: 100%;
    margin-top: 6px;
    padding: 12px 20px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--rost);
    cursor: pointer;
    transition:
      background-color 0.16s ease,
      color 0.16s ease,
      border-color 0.16s ease;
  }
  .stimmen-mehr:hover {
    background: var(--rost);
    border-color: var(--rost);
    color: #fff;
  }
  .stimmen-mehr[hidden] {
    display: none;
  }
  @media (min-width: 680px) {
    .stimmen-mehr {
      display: none;
    }
  }

  .stimmen-hinweis {
    margin: clamp(14px, 1.8vw, 20px) 0 0;
    font-size: 12.5px;
    color: var(--meta-text);
  }

  /* ---------- 8b · Workbook ---------- */
  .workbook {
    display: grid;
    gap: clamp(28px, 3.6vw, 56px);
    align-items: center;
  }
  @media (min-width: 960px) {
    .workbook {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    }
  }

  /* Die Doppelseite trägt den Abschnitt, das Cover legt sich davor. Position
     relativ, damit das Cover daran andocken kann. */
  .workbook-bild {
    position: relative;
    padding-bottom: 26px;
  }
  .wb-doppelseite,
  .wb-cover {
    margin: 0;
  }
  .wb-doppelseite img {
    width: 100%;
    display: block;
    border-radius: 2px;
    /* Zwei Schatten: ein harter Ansatz an der Kante, ein weicher darunter.
       So liegt das Heft auf der Fläche, statt darüber zu schweben. */
    box-shadow:
      0 1px 2px rgba(23, 39, 61, 0.1),
      0 18px 40px rgba(23, 39, 61, 0.14);
  }
  .wb-cover {
    position: absolute;
    left: -4px;
    bottom: 0;
    width: 30%;
    max-width: 186px;
    /* Fluchtpunkt für die leichte Drehung des Hefts. */
    perspective: 1600px;
  }

  /* Aus der flachen Fläche wird ein Heft: leicht gedreht, mit Rücken links,
     einem Hauch Blockschnitt rechts und Licht von links oben. */
  .wb-buch {
    position: relative;
    transform: rotateY(-15deg) rotate(-1deg);
    transform-origin: left center;
  }
  .wb-buch img {
    width: 100%;
    display: block;
    border-radius: 1px 3px 3px 1px;
    box-shadow:
      0 1px 2px rgba(23, 39, 61, 0.14),
      0 16px 34px rgba(23, 39, 61, 0.24);
  }
  /* Der Rücken. Dunkel, weil er im Schatten der Drehung liegt. */
  .wb-buch::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 0.8%;
    bottom: 0.8%;
    width: 8px;
    border-radius: 2px 0 0 2px;
    background: linear-gradient(
      90deg,
      rgba(10, 22, 40, 0.55) 0%,
      rgba(16, 35, 63, 0.95) 45%,
      rgba(16, 35, 63, 1) 100%
    );
  }
  /* Licht von links oben plus ein schmaler heller Streifen am offenen Rand,
     der den Papierblock andeutet. */
  .wb-buch::after {
    content: "";
    position: absolute;
