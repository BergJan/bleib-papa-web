---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../site";

const title = "66 Tage für eure Verbindung | BLEIB PAPA";
const description =
  "Das 66-Tage-Praxisprogramm für getrennte Väter: tägliche Audio-Impulse, Workbook und sechs Phasen für mehr Klarheit, Verbindung und Verlässlichkeit im neuen Vater-Alltag.";

/* Solange kein Checkout hinterlegt ist, springen die Kaufbuttons zum Kaufblock. */
const kaufen = SITE.checkoutUrl || "#starten";

const phasen = [
  {
    nr: "Phase 1",
    tage: "Tag 1–10",
    titel: "Deine neue Vaterrolle",
    schlagwort: "Klarheit",
    frage: "Wer möchtest du unter den neuen Bedingungen als Vater sein?",
  },
  {
    nr: "Phase 2",
    tage: "Tag 11–22",
    titel: "Die Tage dazwischen",
    schlagwort: "Verbindung",
    frage: "Wie bleibt ihr verbunden, ohne Kontakt zum Pflichtprogramm zu machen?",
  },
  {
    nr: "Phase 3",
    tage: "Tag 23–34",
    titel: "Zuhause bei Papa",
    schlagwort: "Normalität",
    frage: "Wie wird aus begrenzter Zeit echter Papa-Alltag statt Besuchszeit?",
  },
  {
    nr: "Phase 4",
    tage: "Tag 35–44",
    titel: "Wenn dein Kind nicht da ist",
    schlagwort: "Stabilität",
    frage: "Wie gehst du mit Vermissen, Sorge und deinem eigenen Leben um?",
  },
  {
    nr: "Phase 5",
    tage: "Tag 45–54",
    titel: "Eltern bleiben",
    schlagwort: "Verantwortung",
    frage: "Wie hältst du Konflikte möglichst von der Vater-Kind-Beziehung fern?",
  },
  {
    nr: "Phase 6",
    tage: "Tag 55–66",
    titel: "Eure Beziehung von morgen",
    schlagwort: "Richtung",
    frage:
      "Welche Rituale, gemeinsamen Geschichten und Formen von Vatersein sollen langfristig bleiben?",
  },
];

const umfang = [
  "66 Audio-Impulse",
  "6 Phasen",
  "vollständiges Praxis-Workbook",
  "tägliche Reflexions- und Umsetzungsaufgaben",
  "Zwischenreflexionen",
  "Abschlussreflexion",
  "30-Tage-Check-in",
  "90-Tage-Check-in",
  "digitaler Zugang",
];

const passt = [
  "du Vater nach einer Trennung bist",
  "du dein Kind nicht mehr täglich siehst",
  "dir ein klarer Weg fehlt",
  "du weniger kompensieren und bewusster gestalten möchtest",
  "du wissen möchtest, was du selbst beeinflussen kannst",
  "du wenig Zeit und keine Lust auf Content-Masse hast",
  "du selbstständig arbeiten möchtest",
];

const passtNicht = [
  "du Rechtsberatung suchst",
  "du Psychotherapie oder Krisenintervention benötigst",
  "du primär den anderen Elternteil verändern möchtest",
  "du eine Garantie für das Verhalten deines Kindes erwartest",
  "du 1:1-Betreuung suchst",
  "du eine Community erwartest",
];

const faq = [
  {
    frage: "Wie viel Zeit brauche ich täglich?",
    antwort:
      "Das Programm ist für einen vollen Alltag konzipiert. Du hörst deinen täglichen Impuls und entscheidest anschließend selbst, wie viel Zeit du an diesem Tag für deine Reflexion benötigst.",
  },
  {
    frage: "Muss ich jeden Tag durchziehen?",
    antwort:
      "Nein. Wenn ein Tag ausfällt, gehst du danach weiter. Regelmäßigkeit ist wichtiger als Perfektion.",
  },
  {
    frage: "Ist es ein Abo?",
    antwort:
      "Nein. Es handelt sich um einen einmaligen Kauf. Es entstehen keine laufenden Kosten und du musst nichts kündigen.",
  },
  {
    frage: "Kann ich schneller arbeiten?",
    antwort:
      "Technisch ja. Sinnvoller ist ein Impuls pro Tag. Zwischen den Gedanken soll echtes Leben stattfinden.",
  },
  {
    frage: "Bekomme ich persönliche Betreuung?",
    antwort:
      "Nein. Die 66 Tage sind ein Selbstlernprogramm. Persönliche Begleitung gehört nicht zu diesem Produkt.",
  },
  {
    frage: "Gibt es eine Community?",
    antwort:
      "Nein. Die Community gehört bewusst nicht zu diesem Produkt. Du arbeitest für dich, in deinem Tempo.",
  },
  {
    frage: "Ist es Therapie oder Rechtsberatung?",
    antwort:
      "Nein. BLEIB PAPA ersetzt weder therapeutische noch juristische Beratung. Bei rechtlichen Fragen zu Umgang, Sorge oder Unterhalt wende dich an eine Fachanwältin oder einen Fachanwalt für Familienrecht.",
  },
  {
    frage: "Was, wenn bei uns viel von der Mutter abhängt?",
    antwort:
      "Äußere Bedingungen können deine Situation stark beeinflussen. Das Programm verspricht nicht, den anderen Elternteil zu verändern. Es setzt dort an, wo dein eigener Einfluss als Vater beginnt.",
  },
];
---

<Base title={title} description={description} path="/66-tage/" image="/assets/66-tage-mockup.jpg">
  <a class="skip" href="#so-funktioniert">Direkt zum Programm</a>

  <header class="header">
    <div class="header-in">
      <a class="brand" href="/">Bleib Papa<span class="dot">.</span></a>
      <a class="btn btn-sm" href="#so-funktioniert">Die 66 Tage ansehen</a>
    </div>
  </header>

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero bg-creme">
      <div class="wrap hero-grid">
        <div class="hero-col">
          <div class="hero-text">
            <p class="label">Das 66-Tage-Praxisprogramm für Väter nach der Trennung</p>
            <h1 class="h1">
              66 Tage, um dein Vatersein nach der Trennung nicht länger dem Zufall zu überlassen.
            </h1>
            <p class="produktzeile">BLEIB PAPA — 66 Tage für eure Verbindung</p>
            <p class="lead">
              Ein klarer täglicher Weg mit 66 Audio-Impulsen und einem ausführlichen
              Praxis-Workbook, damit du Schritt für Schritt herausfindest, wie du auch ohne
              täglichen gemeinsamen Alltag verbunden, verlässlich und präsent Papa bleibst.
            </p>
            <p class="value-line">
              66 Tage · 66 Audio-Impulse · 6 Phasen · Workbook · 30- und 90-Tage-Check-in
            </p>
          </div>

          <div class="hero-aktion">
            <a class="btn" href="#so-funktioniert">So funktionieren die 66 Tage ↓</a>
            <p class="hero-meta">Digitales Selbstlernprogramm · einmaliger Kauf · kein Abo</p>
          </div>
        </div>

        <div class="hero-visual">
          <figure class="mockup">
            <img
              src="/assets/66-tage-mockup.jpg"
              width="1000"
              height="1000"
              alt="BLEIB PAPA, 66 Tage für eure Verbindung: Programmbox, Workbook, Kursoberfläche am Bildschirm sowie auf Tablet und Smartphone."
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ WIEDERERKENNUNG ============ -->
    <section class="section bg-white" id="so-funktioniert" style="scroll-margin-top:70px">
      <div class="wrap">
        <p class="label">Du weißt, dass du Papa bleiben willst</p>
        <h2 class="h2 measure-wide">
          Die schwierigere Frage ist: Wie sieht das jetzt im echten Alltag aus?
        </h2>

        <div class="split">
          <div class="scenes">
            <p>
              Vielleicht hast du längst verstanden, dass weniger gemeinsame Zeit nicht automatisch
              weniger Beziehung bedeuten muss. Aber zwischen Verstehen und Leben liegt ein
              Unterschied.
            </p>
            <p>
              Du willst gelassen bleiben. Dann kommt eine Nachricht, die dich sofort wieder
              aufwühlt.
            </p>
            <p>
              Du willst eure gemeinsame Zeit einfach genießen. Dann ertappst du dich dabei, jedes
              Wochenende besonders machen zu wollen.
            </p>
            <p>
              Du möchtest zwischen euren gemeinsamen Tagen verbunden bleiben. Dann fragst du dich,
              ob du zu viel schreibst, zu wenig anrufst oder überhaupt das Richtige tust.
            </p>
          </div>
          <figure class="fig">
            <img
              src="/assets/szene-zeichnung.jpg"
              width="1000"
              height="667"
              alt="Eine Kinderzeichnung liegt abends auf dem Tisch, daneben ein Telefon und ein gerahmtes Foto von Vater und Kind."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>

        <div class="pull">
          <p class="serif">
            Und irgendwann merkst du: Ich muss für mich erst herausfinden, wie mein Vatersein unter
            diesen neuen Bedingungen eigentlich aussehen soll.
          </p>
          <p class="small">Genau dafür gibt es die 66 Tage.</p>
        </div>
      </div>
    </section>

    <!-- ============ 21 WEGE VS 66 TAGE ============ -->
    <section class="section bg-creme">
      <div class="wrap">
        <p class="label">Der nächste Schritt</p>
        <h2 class="h2 measure-wide">21 Wege geben dir Ideen. Die 66 Tage geben dir einen Weg.</h2>

        <div class="split">
          <div>
            <p>
              Mit den 21 Wegen hast du erste konkrete Möglichkeiten bekommen, Verbindung zu
              schaffen. Vielleicht hast du bereits ein Ritual entdeckt, einen anderen Kontaktpunkt
              ausprobiert oder eure gemeinsame Zeit bewusster betrachtet.
            </p>
            <p>
              Aber eine neue Form von Vatersein entsteht nicht aus einer immer längeren Liste guter
              Ideen. Sie entsteht aus Fragen wie:
            </p>
          </div>
          <ul class="fragen">
            <li>Welcher Vater möchte ich jetzt sein?</li>
            <li>Was kann ich wirklich beeinflussen?</li>
            <li>Was braucht mein Kind von mir?</li>
            <li>Wie bleiben wir zwischen unseren gemeinsamen Tagen verbunden?</li>
            <li>Wie entsteht bei mir echter Papa-Alltag?</li>
            <li>Wie gehe ich mit dem Vermissen um?</li>
            <li>Was soll langfristig zwischen uns bleiben?</li>
          </ul>
        </div>

        <div class="pull">
          <p class="serif">
            66 Tage bedeutet nicht: 66 weitere Tipps. 66 Tage bedeutet: jeden Tag einen kleinen
            Schritt weiter.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ KEIN AUDIO-BUNDLE ============ -->
    <section class="section bg-white">
      <div class="wrap">
        <p class="label">Kein Audio-Bundle</p>
        <h2 class="h2 measure-wide">Du bekommst einen vollständigen Weg für die nächsten 66 Tage.</h2>

        <div class="measure" style="margin-top:clamp(24px,2.8vw,34px)">
          <p>
            Jeden Tag neu überlegen zu müssen, was du als Vater jetzt eigentlich tun solltest,
            kostet Energie.
          </p>
          <p class="fragen-inline">
            Soll ich mich melden? Soll ich mehr Abstand lassen? Tue ich genug? Muss ich unsere
            gemeinsame Zeit besonderer machen? Bin ich zu streng? Oder aus Angst schon zu
            nachgiebig?
          </p>
          <p>
            Die 66 Tage nehmen dir diese Entscheidungen nicht ab. Aber sie geben dir jeden Tag
            einen klaren Punkt, auf den du schauen kannst.
          </p>
        </div>

        <div class="topics">
          <div class="topic">
            <div class="num">01</div>
            <h3 class="h3">66 Audio-Impulse</h3>
            <p>Ein klarer Gedanke pro Tag.</p>
          </div>
          <div class="topic">
            <div class="num">02</div>
            <h3 class="h3">6 Phasen</h3>
            <p>Ein aufeinander aufbauender Prozess.</p>
          </div>
          <div class="topic">
            <div class="num">03</div>
            <h3 class="h3">Praxis-Workbook</h3>
            <p>Damit Hören zu eigener Reflexion wird.</p>
          </div>
          <div class="topic">
            <div class="num">04</div>
            <h3 class="h3">Zwischenreflexionen</h3>
            <p>Damit du wahrnimmst, was sich verändert.</p>
          </div>
          <div class="topic">
            <div class="num">05</div>
            <h3 class="h3">Abschlussreflexion</h3>
            <p>Damit Tag 66 zu konkreten Entscheidungen führt.</p>
          </div>
          <div class="topic">
            <div class="num">06</div>
            <h3 class="h3">30- und 90-Tage-Check-in</h3>
            <p>Damit du später überprüfst, was wirklich geblieben ist.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SELBST SUCHEN VS KLARER WEG ============ -->
    <section class="section bg-creme">
      <div class="wrap">
        <p class="label">Was du dir sparst</p>
        <h2 class="h2 measure-wide">
          Du kannst dir all diese Antworten selbst zusammensuchen. Oder du gehst einen klaren Weg.
        </h2>

        <div class="measure" style="margin-top:clamp(24px,2.8vw,34px)">
          <p class="aufzaehlung">
            Podcasts hören. Bücher lesen. Videos speichern. Foren durchsuchen. Unterschiedliche
            Meinungen miteinander vergleichen.
          </p>
          <p>
            Und anschließend trotzdem überlegen: Was davon passt eigentlich zu mir, meinem Kind und
            unserem Alltag?
          </p>
          <p>
            Die 66 Tage nehmen dir diese Suche ab. Die entscheidenden Fragen sind bereits in eine
            sinnvolle Reihenfolge gebracht.
          </p>
        </div>

        <div class="pull">
          <p class="serif">Nicht mehr Information. Mehr Klarheit.</p>
        </div>
      </div>
    </section>

    <!-- ============ ERSTE PREISEINORDNUNG ============ -->
    <section class="section bg-white">
      <div class="wrap">
        <div class="einordnung">
          <p class="label">Dein 66-Tage-Weg</p>
          <h2 class="h2">
            66 Tage klare Orientierung für umgerechnet rund 3,74 € pro Programmtag.
          </h2>
          <p class="preis-zusatz">Einmaliger Kauf · kein Abo</p>
          <p class="lead" style="margin-top:clamp(20px,2.4vw,28px);max-width:600px">
            Statt weiter selbst zu suchen, zu sortieren und auszuprobieren, bekommst du für die
            nächsten 66 Tage einen klaren Rahmen.
          </p>
          <p style="margin-top:clamp(22px,2.6vw,30px)">
            <a class="link-weiter" href="#rhythmus">Weiter ansehen ↓</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ============ TÄGLICHER RHYTHMUS ============ -->
    <section class="section bg-creme" id="rhythmus" style="scroll-margin-top:70px">
      <div class="wrap">
        <p class="label">Dein täglicher Rhythmus</p>
        <h2 class="h2 measure-wide">Ein Gedanke. Eine Reflexion. Ein nächster Schritt.</h2>

        <ol class="steps steps-4">
          <li class="step">
            <span class="num">01</span>
            <h3 class="schritt-titel">Hören</h3>
            <p>Du hörst deinen täglichen Audio-Impuls.</p>
          </li>
          <li class="step">
            <span class="num">02</span>
            <h3 class="schritt-titel">Reflektieren</h3>
            <p>
              Du öffnest die passende Workbook-Seite und überträgst den Gedanken auf deine
              Situation.
            </p>
          </li>
          <li class="step">
            <span class="num">03</span>
            <h3 class="schritt-titel">Umsetzen</h3>
            <p>Du entscheidest, was davon für deinen Alltag relevant ist.</p>
          </li>
          <li class="step">
            <span class="num">04</span>
            <h3 class="schritt-titel">Weitergehen</h3>
            <p>Am nächsten Tag wartet der nächste Gedanke.</p>
          </li>
        </ol>

        <div class="split">
          <div>
            <p class="serif rhythmus-schluss">
              Nicht alles auf einmal. Nicht perfekt. 66 Tage lang.
            </p>
            <p style="margin-top:18px">
              Aus einzelnen Gedanken werden über die Wochen Entscheidungen, die dein Kind im Alltag
              tatsächlich bemerkt: dass du dir Termine merkst, dass du dich meldest, wenn du es
              gesagt hast, dass du weißt, was gerade wichtig ist.
            </p>
          </div>
          <figure class="fig">
            <img
              src="/assets/szene-kalender.jpg"
              width="1000"
              height="667"
              alt="Ein Vater markiert gemeinsam mit seinem Sohn einen Termin im Kalender an der Wand."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ VOLLER ALLTAG ============ -->
    <section class="section bg-white">
      <div class="wrap">
        <div class="split" style="margin-top:0;align-items:center">
          <div>
            <p class="label">Kein zweiter Job</p>
            <h2 class="h2">Gemacht für einen Alltag, der ohnehin schon voll ist.</h2>
          </div>
          <div>
            <p>
              Du brauchst keinen zweiten Job namens Persönlichkeitsentwicklung. Keine riesige
              Kursbibliothek. Keine 48 Videos auf einer „Irgendwann noch anschauen"-Liste.
            </p>
            <p>
              Du bekommst einen klaren täglichen Impuls und entscheidest selbst, wie tief du an
              diesem Tag mit dem Workbook arbeitest.
            </p>
            <p class="betont">Ein Tag. Ein Gedanke. Ein nächster Schritt.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 6 PHASEN ============ -->
    <section class="section bg-creme">
      <div class="wrap">
        <p class="label">Dein 66-Tage-Weg</p>
        <h2 class="h2 measure-wide">Sechs Phasen. Eine neue Richtung für dein Vatersein.</h2>

        <div class="phasen">
          {
            phasen.map((p) => (
              <article class="phase">
                <div class="phase-kopf">
                  <span class="phase-nr">{p.nr}</span>
                  <span class="phase-tage">{p.tage}</span>
                </div>
                <h3 class="h3">{p.titel}</h3>
                <p class="phase-schlagwort">{p.schlagwort}</p>
                <p class="phase-frage">{p.frage}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <figure class="band band-voll">
      <img
        src="/assets/66-tage-mockup-breit.jpg"
        width="1800"
        height="600"
        alt="Das 66-Tage-Programm: Box, Workbook, Kursoberfläche, Tablet und Smartphone mit Audio-Impuls."
        loading="lazy"
        decoding="async"
      />
    </figure>

    <!-- ============ WORKBOOK ============ -->
    <section class="section bg-white">
      <div class="wrap">
        <p class="label">Die zweite Hälfte des Programms</p>
        <h2 class="h2 measure-wide">
          Die Audios geben dir Perspektive. Das Workbook macht daraus deinen eigenen Weg.
        </h2>

        <div class="split">
          <div>
            <p>Das Workbook ist kein Bonus. Es ist ein zentraler Teil der 66 Tage.</p>
            <p>
              Du hörst nicht nur, wie Vatersein funktionieren könnte. Du arbeitest heraus, wie es
              bei dir funktionieren soll.
            </p>
            <ul class="check-list" style="margin-top:26px">
              <li>tägliche Reflexionen</li>
              <li>Schreibflächen</li>
              <li>konkrete nächste Schritte</li>
              <li>Zwischenreflexionen</li>
              <li>persönliche Entscheidungen</li>
              <li>Abschlussreflexion</li>
              <li>30-Tage-Check-in</li>
              <li>90-Tage-Check-in</li>
            </ul>
          </div>
          <figure class="fig">
            <img
              src="/assets/szene-workbook.jpg"
              width="1000"
              height="667"
              alt="Aufgeschlagene Workbook-Seite mit der Überschrift „Meine Tage dazwischen“ auf einem Holztisch, daneben Kaffee und ein gerahmtes Foto."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ NACH TAG 66 ============ -->
    <section class="section bg-creme">
      <div class="wrap">
        <h2 class="h2 measure-wide">Tag 66 ist nicht das Ende.</h2>

        <div class="measure" style="margin-top:clamp(24px,2.8vw,34px)">
          <p>30 Tage später und noch einmal nach 90 Tagen kommst du zurück. Du prüfst:</p>
        </div>
        <ul class="fragen" style="margin-top:20px">
          <li>Was funktioniert inzwischen?</li>
          <li>Welche Rituale sind geblieben?</li>
          <li>Was fühlt sich sicherer an?</li>
          <li>Was ist wieder eingeschlafen?</li>
          <li>Was möchtest du bewusst neu aufnehmen?</li>
        </ul>

        <div class="pull">
          <p class="serif">
            Das Ziel ist nicht, 66 Tage perfekt durchzuhalten. Das Ziel ist, etwas aufzubauen, das
            danach weiterlebt.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ ERGEBNIS ============ -->
    <section class="section bg-white">
      <div class="wrap">
        <p class="label">Worauf du hinarbeitest</p>
        <h2 class="h2 measure-wide">
          Nicht auf Perfektion. Auf mehr Klarheit, Verbindung und Verlässlichkeit.
        </h2>

        <p class="lead measure" style="margin-top:clamp(24px,2.8vw,32px)">
          Nach den 66 Tagen sollst du idealerweise:
        </p>

        <ul class="check-list check-list-breit">
          <li>klarer wissen, welcher Vater du sein möchtest</li>
          <li>weniger unter Kompensationsdruck stehen</li>
          <li>Kontakt zwischen euren Tagen bewusster gestalten</li>
          <li>eigene Rituale entwickelt haben</li>
          <li>mehr Normalität in gemeinsamer Zeit zulassen</li>
          <li>Sorge besser von Kontrolle unterscheiden</li>
          <li>deine Vaterrolle weniger stark von Konflikten bestimmen lassen</li>
          <li>eine klarere Vorstellung von eurer langfristigen Beziehung haben</li>
        </ul>
      </div>
    </section>

    <!-- ============ EVENT-PAPA ============ -->
    <section class="section bg-navy">
      <div class="wrap">
        <p class="serif statement">
          Dein Kind braucht keinen Event-Papa. Es braucht einen Vater, der interessiert, präsent
          und verlässlich bleibt.
        </p>
        <div class="closing">
          <p>
            Du musst verlorene Tage nicht mit spektakulären Wochenenden zurückkaufen. Nähe entsteht
            oft in den kleinen Dingen, die sich wiederholen dürfen.
          </p>
        </div>
      </div>
    </section>

    <figure class="band band-voll">
      <img
        src="/assets/band-fruehstueck.jpg"
        width="1800"
        height="679"
        alt="Ein Vater und sein Sohn sitzen morgens am Frühstückstisch und schauen sich lachend an."
        loading="lazy"
        decoding="async"
      />
    </figure>

    <!-- ============ WAS NICHT VERLANGT WIRD ============ -->
    <section class="section bg-creme">
      <div class="wrap">
        <h2 class="h2 measure-wide">Du musst dafür nicht dein ganzes Leben umkrempeln.</h2>

        <p class="lead measure" style="margin-top:clamp(24px,2.8vw,32px)">Du musst nicht:</p>

