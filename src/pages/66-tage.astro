---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import KaufCta from "../components/KaufCta.astro";
import { SITE } from "../site";

/**
 * Salespage für das 66-Tage-Programm.
 *
 * Aufbau nach dem Briefing vom 19.10.2026: zwölf Abschnitte, vier identische
 * Kauf-Buttons. Die Reihenfolge folgt der Frage, die ein Vater sich beim Lesen
 * stellt, nicht der Reihenfolge, in der das Produkt entstanden ist.
 *
 * Mobil zuerst: Der meiste Verkehr kommt aus Reels und aus der E-Mail-Strecke
 * nach dem Leadmagneten, fast alles davon auf dem Telefon.
 */

const title = "66 Tage für eure Verbindung | BLEIB PAPA";
const description =
  "Das 66-Tage-Programm für getrennte Väter: jeden Tag 10 Minuten Audio und eine Workbook-Seite. 247 € einmalig, kein Abo, 14 Tage Geld-zurück-Garantie.";

/* ---------- Noch zu liefern ----------
   Drei Stellen warten auf Inhalt vom Kunden. Solange sie leer sind, wird der
   betroffene Teil weggelassen statt mit Platzhaltern gefüllt. Erfundene
   Stimmen oder ein toter Link wären schlimmer als eine kürzere Seite. */

/** Alter des Sohnes zum Zeitpunkt der Trennung, als Satzteil nach "war mein Sohn". */
const sohnAlter = "zwei Jahre alt";

/**
 * Tag 1 als Hörprobe. Am 19.10.2026 bewusst abgewählt: Die Seite läuft ohne.
 * Der Bauplan bleibt stehen, falls das später anders entschieden wird. Sobald
 * hier eine Datei steht, erscheinen der Player in Abschnitt 6 und der
 * Hörproben-Button im Hero von selbst.
 */
const tagEins = { datei: "", titel: "" };

/** Zielseite für den Hinweis auf Krisenhilfe. Leer = Text ohne Link. */
const krisenSeite = "";

/**
 * Stimmen von Vätern. Leer = der ganze Abschnitt entfällt.
 *
 * Die Situationszeile aus dem Briefing ("Wochenend-Papa, Sohn 7") liegt nicht
 * vor und bleibt deshalb weg, statt erfunden zu werden. Sie lässt sich je
 * Eintrag nachtragen, ohne dass sich am Rest etwas ändert.
 */
const stimmen: { zitat: string; name: string; situation?: string }[] = [
  {
    zitat:
      "Ich habe lange gedacht, dass ich die verlorene Zeit mit meinem Kind irgendwie ausgleichen muss. Durch das Programm habe ich verstanden, dass es viel mehr darauf ankommt, wie wir unsere gemeinsame Zeit gestalten. Das hat bei mir wirklich etwas verändert.",
    name: "Martin S.",
  },
  {
    zitat:
      "Das schlechte Gewissen war nach der Trennung eigentlich immer dabei. Die 66 Tage haben mir geholfen, anders damit umzugehen und unsere gemeinsame Zeit wieder mehr zu genießen.",
    name: "Tim L.",
  },
  {
    zitat:
      "Ich hatte keine Lust auf irgendwelche theoretischen Ratschläge. Hier bekomme ich jeden Tag einen Gedanken oder eine konkrete Idee, die ich tatsächlich in meinem Alltag als Papa umsetzen kann.",
    name: "Jonathan H.",
  },
  {
    zitat:
      "Besonders geholfen haben mir die Impulse für die Tage, an denen mein Sohn bei seiner Mutter ist. Ich habe jetzt viel mehr Ideen, wie ich unsere Verbindung auch zwischen den Treffen pflegen kann.",
    name: "Roland T.",
  },
  {
    zitat:
      "Was mir besonders gefallen hat: Hier erzählt mir keiner, dass nach einer Trennung alles einfach ist. Die Themen sind ehrlich, alltagsnah und ich habe mich an vielen Stellen wiedererkannt.",
    name: "Sven K.",
  },
  {
    zitat:
      "Manchmal waren es nur fünf Minuten am Tag. Aber einige dieser Gedanken haben mich noch tagelang beschäftigt. Gerade die kleinen Veränderungen machen bei uns inzwischen einen Unterschied.",
    name: "Chris E.",
  },
  {
    zitat:
      "Nach der Trennung musste ich meine Rolle als Vater irgendwie neu finden. Das Programm hat mir geholfen, meinen eigenen Weg zu entwickeln und wieder mehr Sicherheit im Umgang mit der Situation zu bekommen.",
    name: "Carsten S.",
  },
  {
    zitat:
      "Früher wollte ich an unseren Wochenenden immer möglichst viel unternehmen. Heute weiß ich, dass auch ein ganz normaler Samstag auf dem Sofa wertvolle Papa-Zeit sein kann. Das hat uns beiden viel Druck genommen.",
    name: "Sascha L.",
  },
  {
    zitat:
      "Man merkt, dass hinter BLEIB PAPA jemand steckt, der selbst weiß, wie sich diese Situation anfühlt. Genau das macht die Impulse für mich glaubwürdig. Es geht um das echte Leben und die Herausforderungen, die man als getrennter Vater hat.",
    name: "Tobias C.",
  },
  {
    zitat:
      "Ich hätte mir dieses Programm direkt nach unserer Trennung gewünscht. Es hätte mir viele Grübeleien erspart. Für jeden Papa, der auch nach der Trennung eine enge Beziehung zu seinem Kind gestalten möchte, sind die 66 Tage eine echte Bereicherung.",
    name: "Ricardo F.",
  },
];

if (!sohnAlter) {
  console.warn('[66-tage] Feld "sohnAlter" ist leer, im Text steht ein Platzhalter.');
}
if (stimmen.length === 0) {
  console.warn('[66-tage] Keine Stimmen hinterlegt, Abschnitt 8 entfaellt samt drittem Kauf-Button.');
}

/* ---------- Inhalte ---------- */

const szenen = [
  "Du willst gelassen bleiben. Dann kommt eine Nachricht, die dich sofort wieder aufwühlt.",
  "Du willst eure gemeinsame Zeit einfach genießen. Dann ertappst du dich dabei, jedes Wochenende besonders machen zu wollen.",
  "Du willst zwischen euren Tagen verbunden bleiben. Dann fragst du dich, ob du zu viel schreibst, zu wenig anrufst oder überhaupt das Richtige tust.",
];

const wandel = [
  {
    heute: "Jedes Wochenende soll ein Highlight sein.",
    danach: "Ihr habt eigene Rituale und echte Normalität bei dir zuhause.",
  },
  {
    heute: "Du weißt nicht, ob du zu viel schreibst oder zu wenig anrufst.",
    danach: "Du hast einen klaren Kontakt-Rhythmus für die Tage dazwischen.",
  },
  {
    heute: "Streit mit der Mutter färbt jede Begegnung mit deinem Kind.",
    danach: "Deine Vaterrolle hängt nicht mehr am Konflikt.",
  },
  {
    heute: "Die Tage ohne Kind fressen dich auf.",
    danach: "Du kannst mit dem Vermissen umgehen und hast wieder ein eigenes Leben.",
  },
  {
    heute: "Du fragst dich, welche Art Vater du jetzt noch sein kannst.",
    danach: "Du weißt, welcher Vater du sein willst, und handelst danach.",
  },
];

const schritte = [
  { titel: "Hören", text: "dein Audio-Impuls des Tages, ca. 10 Minuten." },
  { titel: "Reflektieren", text: "die passende Workbook-Seite, so tief du willst." },
  { titel: "Umsetzen", text: "ein kleiner Schritt für euren Alltag." },
  { titel: "Weitergehen", text: "morgen wartet der nächste Gedanke." },
];

const phasen = [
  {
    nr: "Phase 1",
    tage: "Tag 1–10",
    titel: "Deine neue Vaterrolle",
    schlagwort: "Klarheit",
    frage: "Wer möchtest du unter den neuen Bedingungen als Vater sein?",
  },
  {
    nr: "Phase 2",
    tage: "Tag 11–22",
    titel: "Die Tage dazwischen",
    schlagwort: "Verbindung",
    frage: "Wie bleibt ihr verbunden, ohne Kontakt zum Pflichtprogramm zu machen?",
  },
  {
    nr: "Phase 3",
    tage: "Tag 23–34",
    titel: "Zuhause bei Papa",
    schlagwort: "Normalität",
    frage: "Wie wird aus begrenzter Zeit echter Papa-Alltag statt Besuchszeit?",
  },
  {
    nr: "Phase 4",
    tage: "Tag 35–44",
    titel: "Wenn dein Kind nicht da ist",
    schlagwort: "Stabilität",
    frage: "Wie gehst du mit Vermissen, Sorge und deinem eigenen Leben um?",
  },
  {
    nr: "Phase 5",
    tage: "Tag 45–54",
    titel: "Eltern bleiben",
    schlagwort: "Verantwortung",
    frage: "Wie hältst du Konflikte möglichst von der Vater-Kind-Beziehung fern?",
  },
  {
    nr: "Phase 6",
    tage: "Tag 55–66",
    titel: "Eure Beziehung von morgen",
    schlagwort: "Richtung",
    frage:
      "Welche Rituale, gemeinsamen Geschichten und Formen von Vatersein sollen langfristig bleiben?",
  },
];

const leistungen = [
  "66 Audio-Impulse à ca. 10 Minuten",
  "Vollständiges Praxis-Workbook",
  "6 aufeinander aufbauende Phasen",
  "Zwischen- und Abschlussreflexion",
  "30- und 90-Tage-Check-in",
  "Sofortiger digitaler Zugang",
];

const passt = [
  "du Vater nach einer Trennung bist und dein Kind nicht mehr täglich siehst",
  "du weniger kompensieren und bewusster gestalten willst",
  "du wenig Zeit hast und keine Lust auf Content-Masse",
  "du lieber selbstständig in deinem Tempo arbeitest",
];

const faq = [
  {
    frage: "Was, wenn bei uns viel von der Mutter abhängt?",
    antwort:
      "Äußere Bedingungen können deine Situation stark beeinflussen. Das Programm verspricht nicht, den anderen Elternteil zu verändern. Es setzt dort an, wo dein eigener Einfluss als Vater beginnt.",
  },
  {
    frage: "Wie viel Zeit brauche ich täglich?",
    antwort:
      "Rund 10 Minuten für den Audio-Impuls. Wie lange du danach mit dem Workbook arbeitest, entscheidest du selbst.",
  },
  {
    frage: "Was, wenn ich einen Tag auslasse?",
    antwort:
      "Nein, du musst nicht jeden Tag durchziehen. Wenn ein Tag ausfällt, gehst du danach weiter. Regelmäßigkeit ist wichtiger als Perfektion.",
  },
  {
    frage: "Ist es Therapie oder Rechtsberatung?",
    antwort:
      "Nein. BLEIB PAPA ersetzt weder therapeutische noch juristische Beratung. Bei rechtlichen Fragen zu Umgang, Sorge oder Unterhalt wende dich an eine Fachanwältin oder einen Fachanwalt für Familienrecht.",
  },
  {
    frage: "Ist es ein Abo?",
    antwort:
      "Nein. Es handelt sich um einen einmaligen Kauf. Es entstehen keine laufenden Kosten und du musst nichts kündigen.",
  },
  {
    frage: "Was ist, wenn es nicht zu mir passt?",
    antwort: "Du hast 14 Tage Geld-zurück-Garantie. Eine kurze Mail genügt.",
  },
  {
    frage: "Bekomme ich persönliche Betreuung oder eine Community?",
    antwort:
      "Nein. Die 66 Tage sind bewusst ein Selbstlernprogramm, du arbeitest für dich und in deinem Tempo.",
  },
];

const kaufen = SITE.checkoutUrl || "#starten";
---

<Base title={title} description={description} path="/66-tage/" image="/assets/66-tage-mockup.jpg">
  <header class="header">
    <div class="header-in">
      <a class="brand" href="/">Bleib Papa<span class="dot">.</span></a>
      {/* Nur am Rechner. Auf dem Handy übernimmt die Leiste am unteren Rand. */}
      <a class="btn btn-sm kopf-kauf" href={kaufen} data-kauf="kopf">Jetzt starten</a>
    </div>
  </header>

  <main>
    <!-- ============ 1 · HERO ============ -->
    <section class="hero bg-creme">
      <div class="wrap hero-grid">
        <div class="hero-col">
          <p class="label">Für Väter nach der Trennung</p>
          <h1 class="h1">
            Du siehst dein Kind nicht mehr jeden Tag. Eure Beziehung muss darunter nicht leiden.
          </h1>
          <p class="lead">
            Das 66-Tage-Programm für getrennte Väter: jeden Tag 10 Minuten Audio und eine
            Workbook-Seite. Damit dein Kind spürt, dass auf Papa Verlass ist, auch zwischen euren
            gemeinsamen Tagen.
          </p>

          <KaufCta name="hero">
            {
              tagEins.datei && (
                <a class="btn-kontur" href="#tag-1" data-audio-sprung>
                  <span aria-hidden="true">▶</span> Tag 1 kostenlos anhören
                </a>
              )
            }
          </KaufCta>
        </div>

        <div class="hero-visual">
          <figure class="mockup">
            <picture>
              <source srcset="/assets/66-tage-mockup.webp" type="image/webp" />
              <img
                src="/assets/66-tage-mockup.jpg"
                width="1000"
                height="1000"
                alt="BLEIB PAPA, 66 Tage für eure Verbindung: Programmbox, Workbook, Kursoberfläche am Bildschirm sowie auf Tablet und Smartphone."
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ 2 · SCHMERZ ============ -->
    <section class="section bg-white">
      <div class="wrap">
        <h2 class="h2 measure-wide">
          Du weißt, dass du Papa bleiben willst. Aber wie sieht das jetzt im echten Alltag aus?
        </h2>

        <div class="szenen">
          {szenen.map((s) => <p>{s}</p>)}
        </div>

        <p class="szenen-schluss">Genau dafür gibt es die 66 Tage.</p>

        <figure class="fig fig-schmal">
          <picture>
            <source srcset="/assets/szene-zeichnung.webp" type="image/webp" />
            <img
              src="/assets/szene-zeichnung.jpg"
              width="1000"
              height="667"
              alt="Eine Kinderzeichnung liegt abends auf dem Tisch, daneben ein Telefon und ein gerahmtes Foto von Vater und Kind."
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
    </section>

    <!-- ============ 3 · REFRAME ============ -->
    <section class="band-reframe">
      <picture class="band-bild">
        <source srcset="/assets/band-fruehstueck.webp" type="image/webp" />
        <img
          src="/assets/band-fruehstueck.jpg"
          width="1800"
          height="679"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="wrap band-text">
        <p class="band-gross">Dein Kind braucht keinen Event-Papa.</p>
        <p class="band-klein">
          Du musst verlorene Tage nicht mit spektakulären Wochenenden zurückkaufen. Nähe entsteht in
          den kleinen Dingen, die sich wiederholen dürfen.
        </p>
      </div>
    </section>

    <!-- ============ 4 · VORHER / NACHHER ============ -->
    <section class="section bg-white">
      <div class="wrap">
        <h2 class="h2 measure-wide">Was sich in 66 Tagen verändern kann</h2>

        <div class="wandel" role="list">
          <div class="wandel-kopf" aria-hidden="true">
            <p class="wandel-titel ist-heute">Heute</p>
            <p class="wandel-titel ist-danach">Nach 66 Tagen</p>
          </div>

          {
            wandel.map((w) => (
              <div class="wandel-paar" role="listitem">
                <p class="wandel-zelle ist-heute">
                  <span class="wandel-marke" aria-hidden="true" />
                  <span class="nur-mobil">Heute</span>
                  {w.heute}
                </p>
                <p class="wandel-zelle ist-danach">
                  <span class="wandel-marke" aria-hidden="true" />
                  <span class="nur-mobil">Nach 66 Tagen</span>
                  {w.danach}
                </p>
              </div>
            ))
          }
        </div>

        <KaufCta name="wandel" />
      </div>
    </section>

    <!-- ============ 5 · JANS GESCHICHTE ============ -->
    <section class="section bg-creme">
      <div class="wrap geschichte">
        <figure class="portrait">
          <picture>
            <source srcset="/assets/jan-portrait.webp" type="image/webp" />
            <img
              src="/assets/jan-portrait.jpg"
              width="860"
              height="954"
              alt="Jan Philip Berg, Gründer von BLEIB PAPA."
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>

        <div class="geschichte-text">
          <p class="label">Warum es BLEIB PAPA gibt</p>
          <h2 class="h2">
            Zwischen meinem Sohn und mir liegen 100 Kilometer. In seinem Alltag bin ich trotzdem
            präsent.
          </h2>

          {/* Die Entfernung steht jetzt in der Überschrift, deshalb hier nicht noch einmal. */}
          <p>
            Als die Trennung kam, war mein Sohn {sohnAlter || "[Alter einsetzen]"}. Aus
            Gute-Nacht-Geschichten wurden Videocalls. Aus Alltag wurden Übergabezeiten.
          </p>
          <p>
            Ich erinnere mich an einen Sonntagabend nach der Übergabe. Im Auto war es still, im
            Rückspiegel nur der leere Kindersitz. Und die Frage, die nicht weggehen wollte: Bin ich
            für ihn jetzt nur noch der Papa vom Wochenende?
          </p>
          <p>
            Am Anfang habe ich vieles gut gemeint und falsch gemacht. Jedes Treffen musste etwas
            Besonderes sein. Ich habe angerufen, wenn er lieber spielen wollte, und mich zu selten
            gemeldet, wenn es wirklich zählte. Ich wollte Zeit zurückkaufen, die man nicht
            zurückkaufen kann.
          </p>
          <p>
            Irgendwann habe ich aufgehört, Events zu planen, und angefangen, Verlässlichkeit
            aufzubauen: feste Rituale, ein Rhythmus für die Tage dazwischen, ganz normale
            Nachmittage. Heute läuft er bei der Übergabe auf mich zu. Nicht, weil ich der
            Spaß-Papa bin. Sondern weil ich da bin.
          </p>
          <p>
            Die 66 Tage sind der Weg, den ich mir damals gewünscht hätte. Keine Trennungstheorie,
            sondern das, was zwischen meinem Sohn und mir wirklich funktioniert.
          </p>

          <p class="signatur">Jan, Papa und Gründer von BLEIB PAPA</p>

          {/* Als Nachsatz, nicht als Hinweiskasten: Die Haltung wirkt stärker,
              wenn sie beiläufig kommt statt als Regelwerk. */}
          <p class="ps">
            <strong>PS:</strong> Dir ist vielleicht aufgefallen, dass du meinen Sohn hier nirgends siehst.
            Kein Foto, kein Name. Er ist der Grund für alles auf dieser Seite, und genau deshalb
            zeige ich ihn nicht. Wer die Privatsphäre seines Kindes ernst nimmt, fängt bei der
            eigenen Website an.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ 6 · SO FUNKTIONIERT'S ============ -->
    <section class="section bg-white" id="so-funktioniert" style="scroll-margin-top:70px">
      <div class="wrap">
        <h2 class="h2 measure-wide">10 Minuten am Tag. Mehr braucht es nicht.</h2>

        <ol class="schritte">
          {
            schritte.map((s, i) => (
              <li>
                <span class="schritt-nr" aria-hidden="true">
                  {i + 1}
                </span>
                <p>
                  <strong>{s.titel}:</strong> {s.text}
                </p>
              </li>
            ))
          }
        </ol>

        <p class="schritte-schluss">
          Kein zweiter Job, keine Video-Bibliothek. Ein Tag, ein Gedanke, ein nächster Schritt.
        </p>

        <div class:list={["hoeren", tagEins.datei && "mit-player"]}>
          {
            tagEins.datei && (
              <div class="player" id="tag-1" style="scroll-margin-top:84px">
                <p class="label">Hör rein: Tag 1 – {tagEins.titel}</p>
                <audio controls preload="none" src={tagEins.datei} data-hoerprobe>
                  Dein Browser kann diese Audiodatei nicht abspielen.
                  <a href={tagEins.datei}>Zum Herunterladen</a>
                </audio>
                <p class="player-hinweis">Direkt abspielbar, ohne E-Mail-Adresse.</p>
              </div>
            )
          }

          <figure class="fig">
            <picture>
              <source srcset="/assets/szene-kalender.webp" type="image/webp" />
              <img
                src="/assets/szene-kalender.jpg"
                width="1000"
                height="667"
                alt="Ein Kalender auf dem Küchentisch, daneben Kopfhörer und eine Tasse Kaffee."
                loading="lazy"
                decoding="async"
              />
            </picture>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ 7 · DIE 6 PHASEN ============ -->
    <section class="section bg-creme">
      <div class="wrap">
        <h2 class="h2 measure-wide">Sechs Phasen. Ein Weg.</h2>

        <div class="zeitstrahl">
          {
            phasen.map((p, i) => (
              <details class="phase" open={i === 0}>
                <summary>
                  <span class="phase-nr">{p.nr}</span>
                  <span class="phase-tage">{p.tage}</span>
                  <span class="phase-titel">{p.titel}</span>
                  <span class="phase-wort">{p.schlagwort}</span>
                </summary>
                <p class="phase-frage">{p.frage}</p>
              </details>
            ))
          }
        </div>

        <p class="phasen-schluss">
          Nach Tag 66 kommst du nach 30 und nach 90 Tagen zurück und prüfst, was geblieben ist.
        </p>
      </div>
    </section>

    <!-- ============ 8 · STIMMEN ============ -->
    {
      /* Erscheint erst, wenn echte Stimmen vorliegen. Erfundene Zitate stehen
         hier nicht, auch nicht als Platzhalter. */
      stimmen.length > 0 && (
        <section class="section bg-white">
          <div class="wrap">
            <h2 class="h2 measure-wide">Was Väter nach den 66 Tagen sagen</h2>
            {/* Auf dem Handy eine Reihe zum Wischen, am Rechner eine Wand aus
                Spalten. Beides kommt mit jeder Anzahl zurecht, zehn Karten
                ergeben in einem starren Raster sonst eine angebrochene Zeile. */}
            <div class="stimmen">
              {stimmen.map((s) => (
                <blockquote class="stimme">
                  <p>„{s.zitat}“</p>
                  <footer>
                    <span class="stimme-name">{s.name}</span>
                    {s.situation && <span class="stimme-lage">{s.situation}</span>}
                  </footer>
                </blockquote>
              ))}
            </div>
            <p class="stimmen-hinweis">
              Nachnamen aus Rücksicht auf die Privatsphäre abgekürzt.
            </p>
            <KaufCta name="stimmen" />
          </div>
        </section>
      )
    }

    <!-- ============ 9 · ANGEBOT + GARANTIE ============ -->
    <section class="section bg-creme" id="starten" style="scroll-margin-top:70px">
      <div class="wrap">
        <h2 class="h2 measure-wide">Alles für deine 66 Tage</h2>

        <div class="angebot">
          <figure class="angebot-bild">
            <picture>
              <source srcset="/assets/66-tage-mockup-breit.webp" type="image/webp" />
              <img
                src="/assets/66-tage-mockup-breit.jpg"
                width="1800"
                height="600"
                alt="Workbook, Kursoberfläche und Audio-Impulse des 66-Tage-Programms nebeneinander."
                loading="lazy"
                decoding="async"
              />
            </picture>
          </figure>

          <div class="angebot-text">
            <ul class="leistungen">
              {
                leistungen.map((l) => (
                  <li>
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path
                        d="M3 8.5l3.2 3.2L13 5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {l}
                  </li>
                ))
              }
            </ul>

            <p class="preis">247 € einmalig <span>inkl. MwSt.</span></p>
            <p class="preis-anker">
              Weniger als ein Freizeitpark-Wochenende, an das ihr euch nach einer Woche nicht mehr
              erinnert.
            </p>

