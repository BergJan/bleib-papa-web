<script>
  /* Scrolltiefe und CTA-Klicks messen. Laeuft nur, wenn zugestimmt wurde,
     denn ohne Einwilligung sind fbq und gtag gar nicht vorhanden. */
  const w = window as any;

  function melde(name: string, daten: Record<string, unknown> = {}) {
    try {
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ event: name, ...daten });
      if (typeof w.gtag === "function") w.gtag("event", name, daten);
      if (typeof w.fbq === "function" && name === "checkout_gestartet") {
        w.fbq("track", "InitiateCheckout", { content_name: "66 Tage", value: 247, currency: "EUR" });
      }
    } catch {
      /* Messung darf nie den Kauf blockieren */
    }
  }

  document.querySelectorAll<HTMLAnchorElement>("a[data-cta]").forEach((a) => {
    a.addEventListener("click", () => {
      melde("checkout_gestartet", { position: a.dataset.cta });
    });
  });

  const marken = [25, 50, 75, 100];
  const erreicht = new Set<number>();
  addEventListener(
    "scroll",
    () => {
      const hoehe = document.body.scrollHeight - innerHeight;
      if (hoehe <= 0) return;
      const anteil = (scrollY / hoehe) * 100;
      for (const m of marken) {
        if (anteil >= m && !erreicht.has(m)) {
          erreicht.add(m);
          melde("scrolltiefe", { prozent: m });
        }
      }
    },
    { passive: true }
  );
</script>
