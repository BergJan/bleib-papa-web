---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE } from "../../site";
import {
  beitraege,
  pfad,
  seoTitel,
  metaBeschreibung,
  cta as ctaVon,
  canonicalVon,
  autorVon,
  alsDatum,
  alsDatumKurz,
  QUELLENART_LABEL,
} from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await beitraege();
  return posts.map((post) => ({
    params: { slug: post.data.slug?.trim() || post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);

const autor = await autorVon(post);
const autorPfad = autor ? `/autor/${autor.id}/` : null;
const cta = ctaVon(post);
/* Halb ausgefuellte Zeilen aus dem Redaktionssystem werden still uebersprungen,
   damit ein Entwurf nie zu leeren Kaesten auf der Seite fuehrt. */
const faq = (d.faq ?? []).filter((f) => f.frage.trim() && f.antwort.trim());

const quellen = (d.quellen ?? [])
  .map((q) => {
    const name = q.name.trim();
    const titel = q.titel?.trim() ?? "";
    const url = q.url?.trim() ?? "";
    return {
      /* Steht der Herausgeber vor dem Titel? Nur wenn beides da ist. */
      vorspann: titel && name ? name : "",
      text: titel || name || url,
      url,
      art: q.art,
      abgerufen: q.abgerufen,
    };
  })
  .filter((q) => q.text);

const seite = new URL(pfad(post), SITE.url).href;
const canonical = canonicalVon(post, seite);
const teilbild = d.ogBild?.trim() || d.bild?.trim() || SITE.blogCta.bild;
const bildAbsolut = new URL(teilbild, SITE.url).href;

/* Strukturierte Daten entstehen aus den Feldern oben. Von Hand muss dafuer
   niemand JSON schreiben. Nur fuer Sonderfaelle gibt es das Feld
   "Schema manuell", das dann alles ersetzt. */
const artikelLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.titel,
  description: metaBeschreibung(post),
  image: [bildAbsolut],
  datePublished: d.datum.toISOString(),
  dateModified: (d.aktualisiert ?? d.datum).toISOString(),
  inLanguage: "de-DE",
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  url: seite,
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: { "@type": "ImageObject", url: new URL(SITE.logo, SITE.url).href },
  },
};
if (autor && autorPfad) {
  artikelLd.author = {
    "@type": "Person",
    name: autor.data.name,
    url: new URL(autorPfad, SITE.url).href,
    ...(autor.data.rolle ? { jobTitle: autor.data.rolle } : {}),
  };
}
if (quellen.some((q) => q.url)) {
  artikelLd.citation = quellen
    .filter((q) => q.url)
    .map((q) => ({
      "@type": "CreativeWork",
      name: q.text,
      url: q.url,
      ...(q.vorspann ? { publisher: { "@type": "Organization", name: q.vorspann } } : {}),
    }));
}

/* FAQ-Markup nur, wenn die Fragen auch sichtbar auf der Seite stehen. */
const faqLd =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: f.frage,
          acceptedAnswer: { "@type": "Answer", text: f.antwort },
        })),
      }
    : null;

let jsonLd: unknown[] = [artikelLd, faqLd].filter(Boolean);
if (d.seo.schemaManuell?.trim()) {
  try {
    jsonLd = [JSON.parse(d.seo.schemaManuell)];
  } catch {
    console.warn(
      `[blog] Ungueltiges JSON im Feld "Schema manuell" bei ${post.id}. Es gilt das automatische Schema.`,
    );
  }
}

const aktualisiert = d.aktualisiert && d.aktualisiertZeigen ? d.aktualisiert : null;
---

<Base
  title={seoTitel(post)}
  description={metaBeschreibung(post)}
  path={pfad(post)}
  canonicalUrl={canonical}
  robots={d.seo.robots}
  image={teilbild}
  ogType="article"
  jsonLd={jsonLd}
>
  <Header />

  <main>
    <article>
      <section class="page-head bg-creme">
        <div class="wrap-narrow post-head">
          <p class="meta">
            <time datetime={d.datum.toISOString()}>{alsDatum(d.datum)}</time>
            {autor && <span class="meta-sep">·</span>}
            {autor && <a href={autorPfad}>{autor.data.name}</a>}
          </p>
          <h1 class="h1">{d.titel}</h1>
        </div>
      </section>

      <section class="section bg-white" style="padding-top:clamp(28px,3.4vw,44px)">
        <div class="wrap-narrow">
          {
            d.bild && (
              <figure class="post-bild">
                <img src={d.bild} alt={d.bildAlt ?? ""} decoding="async" />
                {(d.bildUnterschrift || d.bildQuelle) && (
                  <figcaption>
                    {d.bildUnterschrift}
                    {d.bildUnterschrift && d.bildQuelle && <span class="meta-sep">·</span>}
                    {d.bildQuelle && <span class="bildquelle">{d.bildQuelle}</span>}
                  </figcaption>
                )}
              </figure>
            )
          }

          {
            d.quickAnswer && (
              <aside class="quick-answer" aria-label="Kurze Antwort">
                <p class="label">Kurz gesagt</p>
                <p>{d.quickAnswer}</p>
              </aside>
            )
          }

          <div class="prose">
            <Content />
          </div>

          {
            aktualisiert && (
              <p class="post-stand">
                Zuletzt aktualisiert am{" "}
                <time datetime={aktualisiert.toISOString()}>{alsDatum(aktualisiert)}</time>
              </p>
            )
          }

          {
            faq.length > 0 && (
              <section class="post-faq" aria-labelledby="faq-titel">
                <h2 id="faq-titel">Häufige Fragen</h2>
                {faq.map((f) => (
                  <div class="faq-item">
                    <h3>{f.frage}</h3>
                    <p>{f.antwort}</p>
                  </div>
                ))}
              </section>
            )
          }

          {
            quellen.length > 0 && (
              <section class="post-quellen" aria-labelledby="quellen-titel">
                <h2 id="quellen-titel">Quellen</h2>
                <ol>
                  {quellen.map((q) => (
                    <li>
                      {q.vorspann && <span class="quelle-name">{q.vorspann}{": "}</span>}
                      {q.url ? (
                        <a href={q.url} rel="nofollow noopener" target="_blank">
                          {q.text}
                        </a>
                      ) : (
                        <span class={q.vorspann ? "" : "quelle-name"}>{q.text}</span>
                      )}
                      <span class="quelle-meta">
                        {QUELLENART_LABEL[q.art] ?? q.art}
                        {q.abgerufen && `, abgerufen am ${alsDatumKurz(q.abgerufen)}`}
                      </span>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            cta && (
              <div class="post-cta">
                <figure class="post-cta-bild">
                  <img
                    src={cta.bild}
                    width="1000"
                    height="1000"
                    alt={cta.bildAlt}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="post-cta-text">
                  <h2>{cta.ueberschrift}</h2>
                  <p>{cta.text}</p>
                  <a class="btn" href={cta.buttonUrl}>
                    {cta.buttonText}
                  </a>
                </div>
              </div>
            )
          }

          {
            autor && (
              <aside class="autor-box">
                {autor.data.foto && (
                  <img src={autor.data.foto} alt={`Foto von ${autor.data.name}`} loading="lazy" />
                )}
                <div>
                  <p class="label">Über den Autor</p>
                  <h2>
                    <a href={autorPfad}>{autor.data.name}</a>
                  </h2>
                  <p>{autor.data.kurzvita}</p>
                </div>
              </aside>
            )
          }
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Base>
