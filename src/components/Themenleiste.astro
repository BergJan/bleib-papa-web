---
import { THEMEN, themenPfad } from "../themen";

interface Props {
  /** Schluessel der Welt, auf der der Leser gerade steht. */
  aktiv?: string;
}
const { aktiv } = Astro.props;
---

{/* Die Leiste steht auf der Blogübersicht und auf jeder Themenseite. Damit
    kommt ein Leser von jeder Welt in jede andere, ohne den Zurück-Knopf. */}
<nav class="themenleiste" aria-label="Themenwelten">
  <a class:list={["thema-knopf", !aktiv && "ist-hier"]} href="/blog/">Alle Beiträge</a>
  {
    THEMEN.map((t) => (
      <a
        class:list={["thema-knopf", aktiv === t.schluessel && "ist-hier"]}
        href={themenPfad(t.schluessel)}
        aria-current={aktiv === t.schluessel ? "page" : undefined}
      >
        {t.name}
      </a>
    ))
  }
</nav>

<script>
  /**
   * Auf dem Handy ist die Leiste eine Zeile zum Wischen. Die hinteren Welten
   * liegen dann rechts ausserhalb des Bildes. Wer auf "Deine Rolle als Vater"
   * landet, saehe sonst eine Leiste, in der nichts ausgewaehlt aussieht.
   * Deshalb wird der aktive Knopf hereingeholt, ohne die Seite zu bewegen.
   */
  for (const leiste of document.querySelectorAll<HTMLElement>(".themenleiste")) {
    const aktiv = leiste.querySelector<HTMLElement>(".ist-hier");
    if (!aktiv || leiste.scrollWidth <= leiste.clientWidth) continue;

    const mitte = aktiv.offsetLeft - (leiste.clientWidth - aktiv.offsetWidth) / 2;
    leiste.scrollLeft = Math.max(0, mitte);
  }
</script>
