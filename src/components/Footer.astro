---
import { SITE } from "../site";

interface Props {
  /** Auf Verkaufsseiten kommen AGB und Widerrufsbelehrung dazu (Pflicht). */
  verkauf?: boolean;
}
const { verkauf = false } = Astro.props;
---

<footer class="footer">
  <div class="wrap footer-in">
    <div>
      <span class="brand">Bleib Papa<span class="dot">.</span></span>
      <p class="tag">{SITE.claim}</p>
    </div>
    <nav aria-label="Rechtliches">
      {/* Auch auf der Landingpage: Die Startseite ist die staerkste Seite der
          Domain, und ohne diesen Link haengt der Blog nur an der Sitemap. Im
          Fuss lenkt er nicht vom Opt-in ab. Auf Verkaufsseiten bleibt er weg. */}
      {!verkauf && <a href="/blog/">Blog</a>}
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      {verkauf && <a href="/agb/">AGB</a>}
      {verkauf && <a href="/widerruf/">Widerruf</a>}
      <a href="/kontakt/">Kontakt</a>
    </nav>
  </div>
</footer>
