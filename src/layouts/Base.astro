---
import "../styles/global.css";
import { SITE } from "../site";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  title: string;
  description: string;
  /** Pfad ohne Domain, z. B. "/blog/". Für die Canonical-URL. */
  path?: string;
  /** Vorschaubild für Social Media, Pfad ab Domainwurzel. */
  image?: string;
  /** Auf true setzen, um eine Seite aus Google herauszuhalten (z. B. Danke-Seite). */
  noindex?: boolean;
  /** Feinere Steuerung als noindex, z. B. "noindex, nofollow". Schlaegt noindex. */
  robots?: string;
  /** Canonical von Hand setzen. Leer = eigene URL. */
  canonicalUrl?: string;
  /** "article" auf Blogbeitraegen, sonst "website". */
  ogType?: string;
  /** Strukturierte Daten. Jedes Objekt wird als eigenes JSON-LD ausgegeben. */
  jsonLd?: unknown[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = "/assets/guide-mockup.jpg",
  noindex = false,
  robots,
  canonicalUrl,
  ogType = "website",
  jsonLd = [],
} = Astro.props;

const canonical = canonicalUrl?.trim() || new URL(path, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
const robotsWert = robots ?? (noindex ? "noindex, follow" : null);
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsWert && <meta name="robots" content={robotsWert} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FBF7F1" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Schriften liegen lokal unter /assets/fonts/. Kein Google-Fonts-Aufruf. -->
    <link
      rel="preload"
      href="/assets/fonts/newsreader-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/karla-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonLd.map((eintrag) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(eintrag)}
        />
      ))
    }

    <!-- Platz für Meta-Pixel / GA4. Erst nach Cookie-Einwilligung laden. -->
    <slot name="head" />
  </head>
  <body>
    <slot />
    <ConsentBanner />
  </body>
</html>
